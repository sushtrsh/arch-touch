prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib

Name: Pango Xft
Description: Xft font support for Pango
Version: 1.58.2
Requires: pangoft2, xft >=  2.0.0
Requires.private: pango, glib-2.0 >=  2.88, gobject-2.0 >=  2.88, gio-2.0 >=  2.88, fribidi >=  1.0.6, libthai >=  0.1.9, harfbuzz >=  11.0.0, fontconfig >=  2.17.0, freetype2, xrender, cairo >=  1.18.0, sysprof-capture-4, harfbuzz-gobject >=  11.0.0
Libs: -L${libdir} -lpangoxft-1.0
Libs.private: -lm
Cflags: -I${includedir}/pango-1.0
