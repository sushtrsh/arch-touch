prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib

Name: libcloudproviders
Description: Cloud providers DBus API library.
Version: 0.4.2
Requires: glib-2.0 >=  2.64, gio-2.0 >=  2.64
Requires.private: gio-unix-2.0 >=  2.64
Libs: -L${libdir} -lcloudproviders
Cflags: -I${includedir}/cloudproviders
